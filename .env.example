# Server only. Never prefix a secret with EXPO_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
API_PORT=4188
API_HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:8081
# Public API address, not a secret. For Expo dev/native use this or your LAN IP.
# For combined production web/API hosting, leave empty to use the same origin.
EXPO_PUBLIC_API_URL=http://localhost:4188
# Optional private storage. SERVER ONLY: never use EXPO_PUBLIC_ for this key.
SUPABASE_URL=https://vdwkghogrutalcxacchf.supabase.co
SUPABASE_SECRET_KEY=

# Public origin of this Node API server (it also serves /s/:id and /manage/:id).
# Set after deployment, e.g. https://your-picksell.example.com. No trailing path.
PUBLIC_BASE_URL=http://localhost:4188
# Server-only persistent random signing secret. Without it, tickets expire on restart.
PUBLICATION_SECRET=
